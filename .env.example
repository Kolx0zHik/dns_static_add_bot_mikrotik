BOT_TOKEN=
SSH_TIMEOUT=10

# Глобальный список пользователей можно использовать как общий доступ ко всем роутерам.
# Для строгого разграничения прав лучше задавать MIKROTIK_<ID>_ALLOWED_USERS отдельно.
ALLOWED_USERS=

MIKROTIK_ROUTERS=office,home

MIKROTIK_OFFICE_NAME=Office MikroTik
MIKROTIK_OFFICE_HOST=
MIKROTIK_OFFICE_PORT=22
MIKROTIK_OFFICE_USER=
MIKROTIK_OFFICE_PASSWORD=
MIKROTIK_OFFICE_ALLOWED_USERS=11111111,22222222

MIKROTIK_HOME_NAME=Home MikroTik
MIKROTIK_HOME_HOST=
MIKROTIK_HOME_PORT=22
MIKROTIK_HOME_USER=
MIKROTIK_HOME_PASSWORD=
MIKROTIK_HOME_ALLOWED_USERS=22222222

# Обратная совместимость для одного MikroTik без MIKROTIK_ROUTERS:
# ALLOWED_USERS=11111111,22222222
# MIKROTIK_NAME=MikroTik
# MIKROTIK_HOST=
# MIKROTIK_PORT=22
# MIKROTIK_USER=
# MIKROTIK_PASSWORD=
